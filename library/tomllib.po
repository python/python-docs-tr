msgid "Subclass of :exc:`ValueError`."
msgstr ":exc:`ValueError` alt sınıfı."

#: library/tomllib.rst:69
msgid "Examples"
msgstr "Örnekler"

#: library/tomllib.rst:71
msgid "Parsing a TOML file::"
msgstr "Bir TOML dosyasını ayrıştırma::"

#: library/tomllib.rst:73
msgid ""
"import tomllib\n"
"\n"
"with open(\"pyproject.toml\", \"rb\") as f:\n"
"    data = tomllib.load(f)"
msgstr ""
"import tomllib\n"
"\n"
"with open(\"pyproject.toml\", \"rb\") as f:\n"
"    data = tomllib.load(f)"

#: library/tomllib.rst:78
msgid "Parsing a TOML string::"
msgstr "Bir TOML dizesini ayrıştırma::"

#: library/tomllib.rst:80
msgid ""
"import tomllib\n"
"\n"
"toml_str = \"\"\"\n"
"python-version = \"3.11.0\"\n"
"python-implementation = \"CPython\"\n"
"\"\"\"\n"
"\n"
"data = tomllib.loads(toml_str)"
msgstr ""
"import tomllib\n"
"\n"
"toml_str = \"\"\"\n"
"python-version = \"3.11.0\"\n"
"python-implementation = \"CPython\"\n"
"\"\"\"\n"
"\n"
"data = tomllib.loads(toml_str)"

